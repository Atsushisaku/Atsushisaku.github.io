---
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-sans-jp';
import '../styles/global.css';
import { profile, accounts } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.tagline } = Astro.props;
const siteName = `${profile.nameJa} (${profile.nameEn})`;
const pageTitle = title ? `${title} | ${profile.nameEn}` : siteName;

const nav = [
  { href: '/works/', label: 'Works' },
  { href: '/about/', label: 'About' },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a1317" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(current, Astro.site)} />
    <meta property="og:image" content={new URL(profile.photo.src, Astro.site)} />
  </head>
  <body>
    <!-- nav-bar -->
    <header class="nav-bar">
      <div class="container bar">
        <a class="brand" href="/">{profile.nameEn}</a>
        <nav aria-label="メイン">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href="https://github.com/Atsushisaku" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- footer-region -->
    <footer class="footer-region">
      <div class="container foot t-body-sm">
        <span>© {new Date().getFullYear()} {profile.nameEn}</span>
        <span class="links">
          {accounts.map((a) => <a href={a.href} rel="noopener noreferrer" target="_blank">{a.label}</a>)}
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-base);
    height: 64px;
  }

  .brand {
    white-space: nowrap;
    color: var(--heading);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--spacing-xxs);
  }

  nav a {
    white-space: nowrap;
    padding: var(--spacing-xs) var(--spacing-base);
    border-radius: var(--rounded-full);
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.43;
  }

  nav a:hover {
    background: var(--surface);
  }

  /* nav-pill-active */
  nav a[aria-current='page'] {
    background: var(--heading);
    color: var(--bg);
  }

  @media (max-width: 480px) {
    .brand {
      font-size: 16px;
    }

    nav a {
      padding: var(--spacing-xs) 10px;
      font-size: 13px;
    }
  }

  .footer-region {
    margin-top: var(--spacing-hero);
    padding: var(--spacing-xxl) 0 var(--spacing-section-sm);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--spacing-base);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
  }

  .links a:hover {
    color: var(--heading);
  }
</style>
