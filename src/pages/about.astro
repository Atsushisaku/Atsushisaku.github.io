---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { profile, accounts } from '../data/profile';
import { career, achievements, skills, qualifications, interests } from '../data/career';

const timeline = [...career].reverse();
const shownSkills = skills.filter((s) => s.items.length > 0);
---

<Base title="About" description={`${profile.nameJa}の経歴とプロフィール`}>
  <div class="container">
    <PageHeader kicker="About" title={profile.nameJa} lead={profile.tagline}>
      <dl class="facts mono">
        <div><dt>Name</dt><dd>{profile.nameEn}</dd></div>
        <div><dt>Now</dt><dd>{profile.affiliation}</dd></div>
        <div><dt>From</dt><dd>{profile.hometown}</dd></div>
        <div><dt>Focus</dt><dd>{profile.focus}</dd></div>
      </dl>
    </PageHeader>

    <section class="row">
      <h2 class="mono label"><span>01</span>Career</h2>
      <ol class="timeline">
        {
          timeline.map((c) => (
            <li>
              <span class="mono when">
                {c.start} — {c.end ?? 'Now'}
              </span>
              <div>
                <h3>{c.title}</h3>
                {c.detail && <p class="detail">{c.detail}</p>}
                {c.points && <ul class="points">{c.points.map((p) => <li>{p}</li>)}</ul>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="row">
      <h2 class="mono label"><span>02</span>At Work</h2>
      <div>
        <p class="intro">業務の中で作ったツールや仕組みです。</p>
        <div class="tiles">
          {
            achievements.map((a) => (
              <article class="tile">
                <p class="mono tech">{a.tech}</p>
                <h3>{a.title}</h3>
                <ul class="points">{a.points.map((p) => <li>{p}</li>)}</ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="row">
      <h2 class="mono label"><span>03</span>Skills</h2>
      <dl class="skills">
        {
          shownSkills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>
                <ul class="chips">{s.items.map((i) => <li>{i}</li>)}</ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="row">
      <h2 class="mono label"><span>04</span>Certifications</h2>
      <ul class="certs">
        {
          qualifications.map((q) => (
            <li>
              <span class="mono when">{q.date}</span>
              <span>{q.name}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="row">
      <h2 class="mono label"><span>05</span>Interests</h2>
      <div class="tiles">
        {
          interests.map((it) => (
            <article class="tile">
              <h3>{it.title}</h3>
              <ul class="points">{it.notes.map((n) => <li>{n}</li>)}</ul>
              {it.link && <a class="arrow-link small" href={it.link.href}>{it.link.label}</a>}
            </article>
          ))
        }
      </div>
    </section>

    <section class="row">
      <h2 class="mono label"><span>06</span>Motto</h2>
      <blockquote class="motto">
        {profile.motto.lines.map((l) => <p>{l}</p>)}
        <cite class="mono">— {profile.motto.author}</cite>
      </blockquote>
    </section>

    <section class="row">
      <h2 class="mono label"><span>07</span>Links</h2>
      <ul class="links">
        {
          accounts.map((a) => (
            <li>
              <a class="btn" href={a.href} target="_blank" rel="noopener noreferrer">
                {a.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    margin: 2.5rem 0 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--line);
  }

  .facts div {
    padding: 0.9rem 1.1rem;
    background: var(--bg-elev);
  }

  .facts dt {
    color: var(--faint);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0.2rem 0 0;
    font-family: var(--font);
    font-size: 0.92rem;
    letter-spacing: 0;
  }

  /* 左にラベル、右に中身の 2 カラム */
  .row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1.5rem 2.5rem;
    padding: clamp(2.5rem, 6vw, 4rem) 0;
    border-top: 1px solid var(--line);
  }

  .label {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    margin: 0;
    font-weight: 500;
    color: var(--muted);
    text-transform: uppercase;
  }

  .label span {
    color: var(--accent);
    margin-right: 0.7rem;
  }

  h3 {
    font-size: 1.08rem;
    font-weight: 650;
  }

  .when {
    color: var(--muted);
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline > li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.3rem 1.5rem;
    padding: 0 0 2rem;
  }

  .timeline > li:last-child {
    padding-bottom: 0;
  }

  .timeline > li:first-child h3 {
    color: var(--accent);
  }

  .timeline .when {
    padding-top: 0.25rem;
  }

  .detail {
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
  }

  .points {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .points li {
    position: relative;
    padding-left: 1.1rem;
    margin-top: 0.3rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.45rem;
    height: 1px;
    background: var(--accent);
  }

  .intro {
    margin: 0 0 1.25rem;
    color: var(--muted);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
  }

  .tile {
    padding: 1.25rem 1.35rem;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.25s ease;
  }

  .tile:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
  }

  .tech {
    margin: 0 0 0.4rem;
    color: var(--accent);
    font-size: 0.7rem;
  }

  .small {
    display: inline-flex;
    margin-top: 0.8rem;
    font-size: 0.88rem;
  }

  .skills {
    display: grid;
    gap: 1.1rem;
    margin: 0;
  }

  .skills div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
  }

  .skills dt {
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 0.25rem;
  }

  .skills dd {
    margin: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 0.25rem 0.75rem;
    font-size: 0.84rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg-elev);
  }

  .certs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .certs li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.5rem;
    padding: 0.35rem 0;
  }

  .motto {
    margin: 0;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.45;
  }

  .motto p {
    margin: 0;
  }

  .motto cite {
    display: block;
    margin-top: 1rem;
    font-style: normal;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 800px) {
    .row {
      grid-template-columns: 1fr;
    }

    .label {
      position: static;
    }

    .timeline > li,
    .certs li,
    .skills div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
