---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { profile, accounts } from '../data/profile';
import { career, achievements, skills, qualifications, interests } from '../data/career';

const timeline = [...career].reverse();
const shownSkills = skills.filter((s) => s.items.length > 0);
---

<Base title="About" description={`${profile.nameJa}の経歴とプロフィール`}>
  <div class="container">
    <PageHeader eyebrow="About" title={profile.nameJa} lead={profile.tagline}>
      <!-- stat-panel -->
      <dl class="facts">
        <div><dt>名前</dt><dd>{profile.nameEn}</dd></div>
        <div><dt>所属</dt><dd>{profile.affiliation}</dd></div>
        <div><dt>出身</dt><dd>{profile.hometown}</dd></div>
        <div><dt>分野</dt><dd>{profile.focus}</dd></div>
      </dl>
    </PageHeader>

    <section class="row">
      <h2 class="t-heading-md label">経歴</h2>
      <ol class="timeline">
        {
          timeline.map((c) => (
            <li>
              <span class="t-body-sm muted">
                {c.start} – {c.end ?? '現在'}
              </span>
              <div>
                <h3 class="t-subtitle-lg">{c.title}</h3>
                {c.detail && <p class="detail">{c.detail}</p>}
                {c.points && <ul class="bullets t-body-sm">{c.points.map((p) => <li>{p}</li>)}</ul>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="row">
      <h2 class="t-heading-md label">業務内開発</h2>
      <div class="tiles">
        {
          achievements.map((a) => (
            <article class="card-tile">
              <p class="eyebrow">{a.tech}</p>
              <h3 class="t-subtitle-lg">{a.title}</h3>
              <ul class="bullets t-body-sm">{a.points.map((p) => <li>{p}</li>)}</ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="row">
      <h2 class="t-heading-md label">スキル</h2>
      <dl class="skills">
        {
          shownSkills.map((s) => (
            <div>
              <dt class="t-body-sm muted">{s.group}</dt>
              <dd>
                <ul class="chips">{s.items.map((i) => <li>{i}</li>)}</ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="row">
      <h2 class="t-heading-md label">資格</h2>
      <ul class="certs">
        {
          qualifications.map((q) => (
            <li>
              <span class="t-body-sm muted">{q.date}</span>
              <span>{q.name}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="row">
      <h2 class="t-heading-md label">趣味・関心</h2>
      <div class="tiles">
        {
          interests.map((it) => (
            <article class="card-tile">
              <h3 class="t-subtitle-lg">{it.title}</h3>
              <ul class="bullets t-body-sm">{it.notes.map((n) => <li>{n}</li>)}</ul>
              {it.link && <a class="link arrow t-body-sm more" href={it.link.href}>{it.link.label}</a>}
            </article>
          ))
        }
      </div>
    </section>

    <section class="row">
      <h2 class="t-heading-md label">信条</h2>
      <blockquote class="motto">
        <p class="t-heading-sm">{profile.motto.lines.map((l) => <span>{l}</span>)}</p>
        <cite class="t-body-sm muted">— {profile.motto.author}</cite>
      </blockquote>
    </section>

    <section class="row">
      <h2 class="t-heading-md label">リンク</h2>
      <div class="links">
        {
          accounts.map((a) => (
            <a class="btn btn-ghost" href={a.href} target="_blank" rel="noopener noreferrer">
              {a.label} ↗
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--spacing-xs);
    margin: var(--spacing-xxl) 0 0;
  }

  .facts div {
    padding: var(--spacing-lg) var(--spacing-xl);
    border-radius: var(--rounded-xxl);
    background: var(--surface);
  }

  .facts dt {
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
  }

  .facts dd {
    margin: var(--spacing-xxs) 0 0;
    color: var(--heading);
    font-weight: 500;
    white-space: pre-line;
  }

  /* 左に見出し、右に中身 */
  .row {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: var(--spacing-xl) var(--spacing-xxxl);
    padding: var(--spacing-section) 0;
    border-top: 1px solid var(--line);
  }

  .label {
    align-self: start;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline > li {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--spacing-xxs) var(--spacing-xl);
  }

  .timeline > li + li {
    margin-top: var(--spacing-xxl);
  }

  .timeline > li > span {
    padding-top: 0.25em;
  }

  .detail {
    margin: var(--spacing-xxs) 0 0;
    color: var(--sub);
    /* データ側の \n をそのまま改行として表示する */
    white-space: pre-line;
  }

  .timeline .bullets {
    margin-top: var(--spacing-xs);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--spacing-base);
  }

  .card-tile {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-xl);
    border: 1px solid var(--line);
    border-radius: var(--rounded-xl);
    background: var(--bg);
  }

  .card-tile .eyebrow {
    margin: 0;
  }

  .more {
    margin-top: auto;
    padding-top: var(--spacing-xs);
  }

  .skills {
    display: grid;
    gap: var(--spacing-base);
    margin: 0;
  }

  .skills div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--spacing-base);
  }

  .skills dd {
    margin: 0;
  }

  .certs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .certs li {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--spacing-xl);
    padding: var(--spacing-xxs) 0;
  }

  .motto {
    margin: 0;
  }

  .motto p {
    margin: 0;
    color: var(--heading);
  }

  .motto span {
    display: block;
  }

  .motto cite {
    display: block;
    margin-top: var(--spacing-md);
    font-style: normal;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
      padding: var(--spacing-section-sm) 0;
    }

    .timeline > li,
    .certs li,
    .skills div {
      grid-template-columns: 1fr;
      gap: var(--spacing-xxs);
    }
  }
</style>
