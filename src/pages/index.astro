---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import IconLinks from '../components/IconLinks.astro';
import { profile } from '../data/profile';
import { career } from '../data/career';
import { works } from '../data/works';

const featured = works.filter((w) => w.featured);
const [lead, ...rest] = featured;
const recent = [...career].reverse().slice(0, 4);
---

<Base>
  <section class="hero container">
    <div class="intro">
      <p class="eyebrow">{profile.focus}</p>
      <h1 class="t-hero">{profile.nameJa}</h1>
      <p class="en t-heading-md">{profile.nameEn}</p>
      <p class="tagline t-heading-sm">{profile.catchcopy}</p>
      <p class="desc">{profile.description}</p>
      <div class="cta">
        <a class="btn btn-primary" href="/works/">開発物を見る</a>
        <a class="btn" href="/about/">経歴・プロフィール</a>
      </div>
    </div>
    <!-- hero-portrait -->
    <Image
      class="portrait"
      src={profile.photo}
      alt={`${profile.nameJa}の写真`}
      widths={[360, 720]}
      sizes="(min-width: 1024px) 360px, 240px"
      loading="eager"
    />
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Selected Works" title="開発物">
      <a class="link arrow" href="/works/">すべて見る</a>
    </SectionHeading>
    {lead && <WorkCard work={lead} feature />}
    <div class="grid">
      {rest.map((w) => <WorkCard work={w} />)}
    </div>
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Experience" title="経歴">
      <a class="link arrow" href="/about/">詳しく見る</a>
    </SectionHeading>
    <ol class="exp">
      {
        recent.map((c) => (
          <li>
            <span class="t-body-sm muted when">
              {c.start} – {c.end ?? '現在'}
            </span>
            <div>
              <h3 class="t-subtitle-lg">{c.title}</h3>
              {c.detail && <p class="muted">{c.detail}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container">
    <!-- card-promo-strip -->
    <div class="card-promo-strip">
      <p class="eyebrow">Links</p>
      <h2 class="t-display">Find me on</h2>
      <div class="accounts">
        <IconLinks onDark />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--spacing-section);
    padding-top: var(--spacing-hero);
  }

  .en {
    margin: var(--spacing-xs) 0 0;
    color: var(--muted);
  }

  .tagline {
    max-width: 36rem;
    margin: var(--spacing-xl) 0 0;
    color: var(--text);
  }

  .desc {
    max-width: 36rem;
    margin: var(--spacing-xs) 0 0;
    color: var(--sub);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xxl);
  }

  .portrait {
    width: 360px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--rounded-xxxl);
    background: var(--surface);
  }

  .grid {
    display: grid;
    /* 枚数が少なくても空の列を残さず、横幅いっぱいに並べる */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--spacing-xl);
    margin-top: var(--spacing-xl);
  }

  .exp {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .exp li {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--spacing-xxs) var(--spacing-xxl);
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid var(--line);
  }

  .when {
    padding-top: 0.2em;
  }

  .exp p {
    margin: var(--spacing-xxs) 0 0;
    white-space: pre-line;
  }

  .card-promo-strip {
    padding: var(--spacing-section);
    border-radius: var(--rounded-xxxl);
    background: var(--color-ink-deep);
    color: var(--color-canvas);
  }

  .card-promo-strip h2 {
    color: var(--color-canvas);
  }

  .card-promo-strip .eyebrow {
    color: var(--color-primary-dark);
  }

  .accounts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xxl);
  }

  /* ダークモードでは帯を地と区別できるよう一段明るい面にする */
  @media (prefers-color-scheme: dark) {
    .card-promo-strip {
      background: var(--surface);
      border: 1px solid var(--line);
    }
  }

  @media (max-width: 1023px) {
    .portrait {
      width: 280px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--spacing-xxl);
      padding-top: var(--spacing-section-sm);
    }

    .portrait {
      order: -1;
      width: 200px;
    }

    .exp li {
      grid-template-columns: 1fr;
    }

    .card-promo-strip {
      padding: var(--spacing-xxl) var(--spacing-xl);
    }
  }
</style>
