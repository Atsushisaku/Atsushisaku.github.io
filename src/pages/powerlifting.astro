---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { meets, best, total, type Attempt } from '../data/powerlifting';

const lifts = [
  { key: 'squat', label: 'スクワット' },
  { key: 'bench', label: 'ベンチプレス' },
  { key: 'deadlift', label: 'デッドリフト' },
] as const;

const fmt = (n: number) => String(n);
const ordered = [...meets].reverse();
const bestTotal = Math.max(...meets.map(total));
const bestOf = (key: (typeof lifts)[number]['key']) => Math.max(...meets.map((m) => best(m[key])));
---

<Base title="パワーリフティング" description="パワーリフティングの大会成績">
  <div class="container">
    <PageHeader eyebrow="Powerlifting" title="大会成績" lead="取り消し線は失敗した試技です。">
      <!-- stat-panel -->
      <div class="stats">
        <div class="stat-panel">
          <span class="t-caption">ベストトータル</span>
          <strong class="t-heading-lg accent">{fmt(bestTotal)}<small>kg</small></strong>
        </div>
        {
          lifts.map(({ key, label }) => (
            <div class="stat-panel">
              <span class="t-caption">{label}</span>
              <strong class="t-heading-lg">
                {fmt(bestOf(key))}
                <small>kg</small>
              </strong>
            </div>
          ))
        }
      </div>
    </PageHeader>

    <div class="meets">
      {
        ordered.map((m) => (
          <article class="meet">
            <p class="t-body-sm muted meta">
              {m.fiscalYear}年度 · {m.weightClass} · 体重 {fmt(m.bodyweight)}kg
            </p>
            <h2 class="t-subtitle-lg">{m.name}</h2>
            <div class="result">
              <span class="badge-accent">{m.place}</span>
              {m.awards?.map((a) => <span class="badge-accent">{a}</span>)}
              <span class="sum">
                <span class="t-body-sm muted">トータル</span>
                <strong class="t-heading-sm">{fmt(total(m))}</strong>
                <span class="t-body-sm muted">kg</span>
              </span>
            </div>
            <!-- spec-table -->
            <table class="spec-table t-body-sm">
              <tbody>
                {lifts.map(({ key, label }) => (
                  <tr>
                    <th scope="row">{label}</th>
                    {(m[key] as Attempt[]).map(([w, good]) => (
                      <td class={good ? undefined : 'miss'}>{good ? fmt(w) : <s>{fmt(w)}</s>}</td>
                    ))}
                    <td class="best">{fmt(best(m[key]))}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </article>
        ))
      }
    </div>

    <p class="assoc">
      <a class="link arrow" href="https://powerlifting-ibaraki.jp/" target="_blank" rel="noopener noreferrer">茨城県パワーリフティング協会</a>
    </p>
  </div>
</Base>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-xs);
    margin-top: var(--spacing-xxl);
  }

  .stat-panel {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xxs);
    padding: var(--spacing-xl);
    border-radius: var(--rounded-xxl);
    background: var(--surface);
  }

  .stat-panel span {
    color: var(--muted);
    font-weight: 700;
  }

  .stat-panel strong {
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }

  .stat-panel .accent {
    color: var(--accent);
  }

  .stat-panel small {
    margin-left: 2px;
    font-size: 0.5em;
    color: var(--muted);
  }

  .meets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    gap: var(--spacing-xl);
  }

  .meet {
    padding: var(--spacing-xxl);
    border: 1px solid var(--line);
    border-radius: var(--rounded-xxxl);
  }

  .meta {
    margin: 0;
  }

  .result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs);
    margin: var(--spacing-md) 0 var(--spacing-lg);
  }

  /* badge-accent */
  .badge-accent {
    padding: var(--spacing-xxs) 10px;
    border-radius: var(--rounded-full);
    background: var(--accent);
    color: var(--bg);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.5;
  }

  .sum {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-xxs);
    margin-left: auto;
  }

  .sum strong {
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .spec-table th,
  .spec-table td {
    padding: var(--spacing-xs) var(--spacing-xxs);
    border-top: 1px solid var(--line);
    text-align: right;
  }

  .spec-table th {
    text-align: left;
    font-weight: 700;
    color: var(--text);
  }

  .miss {
    color: var(--faint);
  }

  .best {
    font-weight: 700;
    color: var(--heading);
  }

  .assoc {
    margin-top: var(--spacing-xxl);
  }

  @media (max-width: 767px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .meet {
      padding: var(--spacing-xl);
    }
  }
</style>
