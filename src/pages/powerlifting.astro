---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { meets, best, total, type Attempt } from '../data/powerlifting';

const lifts = [
  { key: 'squat', label: 'スクワット' },
  { key: 'bench', label: 'ベンチプレス' },
  { key: 'deadlift', label: 'デッドリフト' },
] as const;

const fmt = (n: number) => String(n);
const ordered = [...meets].reverse();

// 順位・賞ごとのバッジの色（DESIGN.md の badge-gold / silver / bronze / mvp）。無いものは badge-accent
const badgeClass: Record<string, string> = {
  優勝: 'badge-gold',
  準優勝: 'badge-silver',
  '3位': 'badge-bronze',
  最優秀選手: 'badge-mvp',
};
const badge = (label: string) => `badge ${badgeClass[label] ?? 'badge-accent'}`;
---

<Base title="パワーリフティング" description="パワーリフティングの大会成績">
  <div class="container">
    <PageHeader eyebrow="Powerlifting" title="大会成績" />

    <div class="meets">
      {
        ordered.map((m) => (
          <article class="meet">
            <p class="t-body-sm muted meta">
              {m.fiscalYear}年度 · {m.weightClass} · 体重 {fmt(m.bodyweight)}kg
            </p>
            <h2 class="t-subtitle-lg">{m.name}</h2>
            <div class="result">
              <span class={badge(m.place)}>{m.place}</span>
              {m.awards?.map((a) => <span class={badge(a)}>{a}</span>)}
              <span class="sum">
                <span class="t-body-sm muted">トータル</span>
                <strong class="t-heading-sm">{fmt(total(m))}</strong>
                <span class="t-body-sm muted">kg</span>
              </span>
            </div>
            {m.comment && <p class="comment">{m.comment}</p>}
            <!-- spec-table -->
            <table class="spec-table t-body-sm">
              <tbody>
                {lifts.map(({ key, label }) => (
                  <tr>
                    <th scope="row">{label}</th>
                    {(m[key] as Attempt[]).map(([w, good]) => (
                      <td class={good ? undefined : 'miss'}>{good ? fmt(w) : <s>{fmt(w)}</s>}</td>
                    ))}
                    <td class="best">{fmt(best(m[key]))}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </article>
        ))
      }
    </div>

    <p class="assoc">
      <a class="link arrow" href="https://powerlifting-ibaraki.jp/" target="_blank" rel="noopener noreferrer">茨城県パワーリフティング協会</a>
    </p>
  </div>
</Base>

<style>
  .meets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    gap: var(--spacing-xl);
  }

  .meet {
    padding: var(--spacing-xxl);
    border: 1px solid var(--line);
    border-radius: var(--rounded-xxxl);
  }

  .meta {
    margin: 0;
  }

  .result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs);
    margin: var(--spacing-md) 0 var(--spacing-lg);
  }

  .badge {
    padding: var(--spacing-xxs) 10px;
    border-radius: var(--rounded-full);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.5;
  }

  .badge-accent {
    background: var(--accent);
    color: var(--bg);
  }

  .badge-gold {
    background: var(--color-medal-gold);
    color: var(--color-on-medal-gold);
  }

  .badge-silver {
    background: var(--color-medal-silver);
    color: var(--color-on-medal-silver);
  }

  .badge-bronze {
    background: var(--color-medal-bronze);
    color: var(--color-on-medal-bronze);
  }

  .badge-mvp {
    /* 枠線のぶん余白を 1px 詰めて、ほかのバッジと高さをそろえる */
    padding: 3px 9px;
    border: 1px solid var(--color-on-medal-mvp);
    background: var(--color-medal-mvp);
    color: var(--color-on-medal-mvp);
  }

  .comment {
    margin: 0 0 var(--spacing-lg);
    color: var(--sub);
    /* データ側の 
 をそのまま改行として表示する */
    white-space: pre-line;
  }

  .sum {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-xxs);
    margin-left: auto;
  }

  .sum strong {
    color: var(--heading);
    font-variant-numeric: tabular-nums;
  }

  .spec-table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .spec-table th,
  .spec-table td {
    padding: var(--spacing-xs) var(--spacing-xxs);
    border-top: 1px solid var(--line);
    text-align: right;
  }

  .spec-table th {
    text-align: left;
    font-weight: 700;
    color: var(--text);
  }

  .miss {
    color: var(--faint);
  }

  .best {
    font-weight: 700;
    color: var(--heading);
  }

  .assoc {
    margin-top: var(--spacing-xxl);
  }

  @media (max-width: 767px) {
    .meet {
      padding: var(--spacing-xl);
    }
  }
</style>
