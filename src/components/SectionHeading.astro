---
interface Props {
  index: string;
  title: string;
  sub?: string;
}

const { index, title, sub } = Astro.props;
---

<div class="heading">
  <p class="mono label"><span>{index}</span>{sub}</p>
  <h2>{title}</h2>
  <slot />
</div>

<style>
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .label {
    flex-basis: 100%;
    margin: 0;
    color: var(--muted);
  }

  .label span {
    color: var(--accent);
    margin-right: 0.75rem;
  }

  h2 {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
</style>
