---
// section-heading: eyebrow + display-lg の見出し。右側に「すべて見る」などのリンクを置ける
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<div class="heading">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="t-display">{title}</h2>
  </div>
  <slot />
</div>

<style>
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--spacing-base);
    margin-bottom: var(--spacing-xxl);
  }
</style>
