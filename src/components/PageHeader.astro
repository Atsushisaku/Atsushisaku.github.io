---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="page-header">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="t-hero">{title}</h1>
  {lead && <p class="t-subtitle-md lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-header {
    padding: var(--spacing-section-lg) 0 var(--spacing-section-sm);
  }

  .lead {
    max-width: 40rem;
    margin: var(--spacing-xl) 0 0;
    color: var(--muted);
  }

  @media (max-width: 767px) {
    .page-header {
      padding-top: var(--spacing-section-sm);
    }
  }
</style>
