---
import type { Work } from '../data/works';

interface Props {
  work: Work;
}

const { work } = Astro.props;
---

<article class="card">
  <h3>{work.name}</h3>
  <p>{work.summary}</p>
  <ul class="tags">{work.tech.map((t) => <li>{t}</li>)}</ul>
  <div class="actions">
    {work.demo && <a href={work.demo} target="_blank" rel="noopener noreferrer">デモを開く →</a>}
    {work.repo && <a href={work.repo} target="_blank" rel="noopener noreferrer">GitHub</a>}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  p {
    margin: 0;
    font-size: 0.95rem;
  }

  .actions {
    display: flex;
    gap: 1.25rem;
    margin-top: auto;
    font-size: 0.92rem;
  }
</style>
