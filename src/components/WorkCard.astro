---
import { Image } from 'astro:assets';
import type { Work } from '../data/works';

interface Props {
  work: Work;
  // card-work-feature: 画像と説明を左右に並べる大きなカード
  feature?: boolean;
  // 箇条書きまで出す（Works ページ用）
  detailed?: boolean;
}

const { work, feature = false, detailed = false } = Astro.props;
const href = work.demo ?? work.repo;
---

<article class:list={[feature ? 'card-work-feature' : 'card-work']}>
  <a class="media" href={href} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
    {
      work.image ? (
        <Image
          src={work.image}
          alt=""
          widths={[480, 800, 1200]}
          sizes={feature ? '(min-width: 1024px) 680px, 100vw' : '(min-width: 1024px) 560px, 100vw'}
          loading={feature ? 'eager' : 'lazy'}
        />
      ) : (
        <span class="cover t-heading-lg">{work.name}</span>
      )
    }
  </a>

  <div class="body">
    {work.tagline && <p class="eyebrow eyebrow-card">{work.tagline}</p>}
    <h3 class:list={[feature ? 't-heading-lg' : 't-heading-sm']}>
      <a href={href} target="_blank" rel="noopener noreferrer">{work.name}</a>
    </h3>
    <p class="summary">{work.summary}</p>
    {(feature || detailed) && work.points && <ul class="bullets t-body-sm">{work.points.map((p) => <li>{p}</li>)}</ul>}
    <ul class="chips">{work.tech.map((t) => <li>{t}</li>)}</ul>
    <div class="actions">
      {work.demo && <a class="btn btn-primary" href={work.demo} target="_blank" rel="noopener noreferrer">サイトを開く</a>}
      {work.repo && <a class="btn btn-ghost" href={work.repo} target="_blank" rel="noopener noreferrer">GitHub</a>}
      {work.note && <span class="t-caption muted">{work.note}</span>}
    </div>
  </div>
</article>

<style>
  .card-work,
  .card-work-feature {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    border-radius: var(--rounded-xxxl);
    transition: transform 0.2s ease-out;
  }

  .card-work {
    padding: var(--spacing-xxl);
    background: var(--bg);
    border: 1px solid var(--line);
  }

  .card-work:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
  }

  .card-work-feature {
    padding: var(--spacing-xxxl);
    background: var(--surface);
  }

  /* card-work-media */
  .media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--rounded-xxl);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .cover {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--heading);
  }

  .card-work-feature .cover {
    background: var(--bg);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    flex: 1;
  }

  .body .eyebrow {
    margin: 0;
  }

  .summary {
    margin: 0;
    color: var(--sub);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-md);
    margin-top: auto;
    padding-top: var(--spacing-xs);
  }

  @media (min-width: 1024px) {
    .card-work-feature {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      align-items: center;
      gap: var(--spacing-xxxl);
    }

    .card-work-feature .media {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 767px) {
    .card-work,
    .card-work-feature {
      padding: var(--spacing-xl);
    }
  }
</style>
